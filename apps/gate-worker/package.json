{
  "name": "orbital-gate-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "../../node_modules/.bin/wrangler dev --config wrangler.toml",
    "deploy": "../../node_modules/.bin/wrangler deploy --config wrangler.local.toml",
    "tail": "../../node_modules/.bin/wrangler tail --config wrangler.local.toml",
    "d1:migrate:local": "../../node_modules/.bin/wrangler d1 migrations apply orbital-waitlist --local --config wrangler.toml",
    "d1:migrate:remote": "../../node_modules/.bin/wrangler d1 migrations apply orbital-waitlist --remote --config wrangler.local.toml",
    "secret": "../../node_modules/.bin/wrangler secret",
    "mint": "tsx scripts/mint-invite.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@types/node": "^25.9.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
}
