{
  "name": "orbital-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "worker:typecheck": "tsc -p tsconfig.worker.json --noEmit",
    "test": "vitest run",
    "deploy": "pnpm build && wrangler deploy",
    "preview": "pnpm build && wrangler dev"
  },
  "dependencies": {
    "jose": "^6.1.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.4",
    "vitest": "^4.1.10",
    "wrangler": "^4.99.0"
  }
}
